{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magi",
  "account_id": "862d327a982abfbbcd56c2ea3f4060d8",
  "main": "build/index.js",
  "compatibility_date": "2026-11-06",
  "build": {
    // The editor's browser code, then the Worker.
    "command": "bun run build:live && worker-build --release",
    "watch_dir": ["src", "core/src", "client"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Aliases can look like anything, so the worker answers first. Only paths
    // that are surely files skip it, which saves a Worker request each.
    "run_worker_first": ["/*", "!/fonts/*", "!/*.css", "!/*.js", "!/*.webp", "!/*.png", "!/*.jpg", "!/*.ico"]
  },
  "kv_namespaces": [
    {
      "binding": "links",
      "id": "links"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}

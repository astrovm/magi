{
  "name": "magi",
  "author": "4st.li",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/native": "npm:typescript@~7.0.2",
    "codemirror": "^6.0.2",
    "eslint": "^10.12.0",
    "lib0": "^0.2.119",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.148.0",
    "y-codemirror.next": "^0.3.6",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "description": "A wizard worm that powers an orb.",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "wrangler dev --port 8788",
    "lint": "bunx eslint .",
    "lint-fix": "bunx eslint . --fix",
    "tsc": "bunx tsc --noEmit",
    "test": "cargo llvm-cov -p magi-core --fail-under-lines 100 --fail-under-functions 100",
    "test:http": "scripts/test-http.sh",
    "build:live": "bun build client/live.js --outfile public/live.js --minify --target browser"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
